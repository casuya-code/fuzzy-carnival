# Frontend environment
NEXT_PUBLIC_RAILWAY_API_URL=http://127.0.0.1:8000

# Optional: if backend API_KEY is configured, browser calls will include it.
# WARNING: NEXT_PUBLIC_* values are exposed to browser users.
# Prefer a server-side proxy for production deployments.
NEXT_PUBLIC_API_KEY=

# Direct R2 upload (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=voice-clone-audio
