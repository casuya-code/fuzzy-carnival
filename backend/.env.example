# Backend environment
# Auth (recommended in production)
API_KEY=
REQUIRE_AUTH=false
AUTH_SECRET=change-me-long-random-secret
AUTH_TOKEN_TTL_HOURS=168
APP_DB_PATH=
EXPOSE_RESET_TOKENS=false
EXPOSE_HEALTH_DETAILS=false

# CORS - set explicit production origins; default is localhost-only
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN_REGEX=^https://your-app\.vercel\.app$

# Upload/static safety
MAX_UPLOAD_MB=300
SERVE_STATIC=true
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOW_LOCAL_MEDIA_FALLBACK=true
REF_CACHE_MAX_FILES=128
REF_CACHE_MAX_AGE_HOURS=72

# Cloudflare R2 (optional; local fallback used when unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=voice-clone-audio
R2_PUBLIC_URL=

# Hugging Face / model cache
HF_TOKEN=
HF_HUB_CACHE=

# TTS providers
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth
AZURE_SWAHILI_VOICE=sw-TZ-DaudiNeural
AZURE_ENGLISH_VOICE=en-US-AriaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_DEFAULT_VOICE_ID=nPczCjzI2devNBz1zQrb
ELEVENLABS_ENABLE_CLONING=false

# Feature flags
ENABLE_KYUTAI=true
ENABLE_AFRISPEECH=true
ENABLE_MSINGI=true
ENABLE_MMS=true
ENABLE_AZURE=true
ENABLE_ELEVENLABS=true

# Rate limiting (Redis when REDIS_URL is set, otherwise process-local)
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Password reset email delivery (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Upload scan webhook (optional, POST metadata JSON; 2xx allows upload)
UPLOAD_SCAN_URL=
UPLOAD_SCAN_TIMEOUT_SEC=5
