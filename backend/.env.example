HF_TOKEN=hf_xxx
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=voice-clone-audio
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
MAX_RAM_GB=7.0
# Memory reserved for one heavy local engine (Msingi/XTTS). Default: 3.0
# HEAVY_ENGINE_RAM_GB=3.0
KYUTAI_WARM=true
ENABLE_KYUTAI=true
ENABLE_AFRISPEECH=true
ENABLE_MSINGI=true
ENABLE_MMS=true
ENABLE_AZURE=true
ENABLE_ELEVENLABS=true
MSINGI_CHECKPOINT_PATH=
# auto = use native sw when the loaded checkpoint supports it; otherwise en-safe fallback.
# Set to sw or en only if you know the checkpoint's supported languages.
MSINGI_LANGUAGE=auto
# COQUI_TOS_AGREED is consumed by Coqui TTS itself; the app calls
# os.environ.setdefault("COQUI_TOS_AGREED", "1") so unattended/server use is
# accepted only when the variable is unset. Set it explicitly to honor your own value.
COQUI_TOS_AGREED=1
AFRISPEECH_CONFIG=
# Custom Swahili loanword/pronunciation JSON; defaults to app/data/swahili_loanwords.json.
# SWAHILI_LOANWORDS_PATH=/app/app/data/swahili_loanwords.json
# Hugging Face hub cache shared by pocket-tts engines and the Docker-build prefetch.
# HF_HUB_CACHE=/app/weights/hub
# Fail the Docker weight-prefetch step if any required model download fails (default: non-fatal).
# PREFETCH_STRICT=1
PUBLIC_BASE_URL=http://localhost:8000
WARM_MMS=true
# Swahili MMS checkpoint (any VITS/MMS-shaped repo with its own tokenizer).
# MMS_MODEL_ID=facebook/mms-tts-swh
DENOISE_REFERENCE=true

# Caption / video defaults
# DEFAULT_INTRO_SEC=1.5
# MAX_INTRO_SEC=60
# DEFAULT_OUTRO_SEC=2.5
# MAX_OUTRO_SEC=10
# DEFAULT_WORDS_PER_CHUNK=3
# MAX_WORDS_PER_CHUNK=8
# DEFAULT_TRIM_END_SEC=0.5
# MAX_TRIM_END_SEC=5

# Packaging defaults
# DEFAULT_CLIP_LENGTH_SEC=40
# MIN_CLIP_LENGTH_SEC=5
# MAX_CLIP_LENGTH_SEC=180

# Social-ready video export defaults
# SOCIAL_VIDEO_CRF=22
# SOCIAL_VIDEO_PRESET=veryfast
# SOCIAL_AUDIO_BITRATE=160k
# SOCIAL_AUDIO_RATE=44100
# SOCIAL_MAXRATE=12M
# SOCIAL_BUFSIZE=24M

# New Cloud Studio Engines
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth
AZURE_SWAHILI_VOICE=sw-TZ-DaudiNeural
AZURE_ENGLISH_VOICE=en-US-AriaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_DEFAULT_VOICE_ID=nPczCjzI2devNBz1zQrb
# Set to true to enable Instant Voice Cloning (IVC) from uploaded voice samples.
ELEVENLABS_ENABLE_CLONING=false
